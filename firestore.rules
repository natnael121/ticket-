rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Super admin check: reads from super_admins collection OR from user doc role
    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/super_admins/$(request.auth.token.telegram_id)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        )
      );
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Telegram app uses anonymous auth, so uid won't match tg_XXXXX doc IDs.
    // We allow any signed-in user to write their own profile freely.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Anonymous uid ≠ tg_userId, so just require auth
    }

    // ── Organizations ──────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if true;              // Public read for event listing
      allow create: if isSignedIn();    // Any authed user can register
      allow update, delete: if isSignedIn(); // Organizers & super admins
    }

    // ── Events ─────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;              // Public event browsing
      allow write: if isSignedIn();
    }

    // ── Ticket Types ───────────────────────────────────────────────────────
    match /ticketTypes/{ticketTypeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();    // Customer order placement
      allow update, delete: if isSignedIn();
    }

    // ── Payments ───────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();    // Customer payment screenshot upload
      allow update, delete: if isSignedIn();
    }

    // ── Tickets ────────────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if true;              // QR scan lookup
      allow write: if isSignedIn();
    }

    // ── Staff ──────────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read, write: if isSignedIn();
    }

    // ── Scan Logs ──────────────────────────────────────────────────────────
    match /scanLogs/{scanLogId} {
      allow read, create: if isSignedIn();
    }

    // ── Super Admins ───────────────────────────────────────────────────────
    match /super_admins/{adminId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
