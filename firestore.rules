rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        getUserData().organizationId == orgId || isSuperAdmin()
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Organizations Collection
    match /organizations/{orgId} {
      allow read: if true; // Public read for event customer views
      allow create: if isSignedIn();
      allow update, delete: if isOrgMember(orgId) || isSuperAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true; // Public events read
      allow create: if isSignedIn() && (isOrgMember(request.resource.data.organizationId) || isSuperAdmin());
      allow update, delete: if isSignedIn() && (isOrgMember(resource.data.organizationId) || isSuperAdmin());
    }

    // Ticket Types Collection
    match /ticketTypes/{ticketTypeId} {
      allow read: if true;
      allow write: if isSignedIn() && (isOrgMember(request.resource.data.organizationId) || isSuperAdmin());
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if true; // Public customer registration
      allow update, delete: if isSignedIn() && (isOrgMember(resource.data.organizationId) || isSuperAdmin());
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if true; // Public payment screenshot upload
      allow update, delete: if isSignedIn() && (isOrgMember(resource.data.organizationId) || isSuperAdmin());
    }

    // Tickets Collection
    match /tickets/{ticketId} {
      allow read: if true; // Required for ticket lookup by token/ID
      allow create: if isSignedIn() && (isOrgMember(request.resource.data.organizationId) || isSuperAdmin());
      allow update: if isSignedIn() && (isOrgMember(resource.data.organizationId) || isSuperAdmin() || getUserData().role == 'staff');
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read, write: if isSignedIn() && (isOrgMember(resource.data.organizationId) || isSuperAdmin());
    }

    // Scan Logs Collection
    match /scanLogs/{scanLogId} {
      allow read, create: if isSignedIn();
    }
  }
}
